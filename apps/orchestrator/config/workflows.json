{
  "$comment": "Workflow catalog. A workflow is an ordered list of steps, each owned by a module agent and bound to one SAP tool. Read steps run at once; a write step waits for the user's confirmation and the run resumes afterwards. Arguments and conditions may use ${input.<name>} and ${steps.<stepId>.<output>}.",
  "workflows": [
    {
      "id": "order-to-cash",
      "name": "Order-to-cash",
      "description": "Takes a sales order through credit check, outbound delivery, goods issue and billing, then verifies the accounting document and the customer account.",
      "agents": ["sd"],
      "subject": "sales order ${input.salesOrder}",
      "input": [
        { "name": "salesOrder", "label": "Sales order", "pattern": "^\\d{1,10}$" },
        { "name": "companyCode", "label": "Company code", "pattern": "^[A-Z0-9]{4}$" }
      ],
      "steps": [
        {
          "id": "order",
          "title": "Check the sales order",
          "agent": "sd",
          "tool": "sd_getSalesOrderFlow",
          "arguments": { "salesOrder": "${input.salesOrder}" }
        },
        {
          "id": "credit",
          "title": "Check the credit exposure",
          "agent": "fico",
          "tool": "credit_getCreditExposure",
          "arguments": { "customer": "${steps.order.soldTo}" },
          "haltWhen": [
            {
              "value": "${steps.order.creditStatus}",
              "equals": "BLOCKED",
              "reason": "The sales order is blocked by the credit check. A credit manager must release it before it can be delivered."
            }
          ]
        },
        {
          "id": "delivery",
          "title": "Create the outbound delivery",
          "agent": "sd",
          "tool": "sd_createDelivery",
          "arguments": { "salesOrder": "${input.salesOrder}" },
          "skipWhen": [{ "value": "${steps.order.hasDelivery}", "equals": "true" }]
        },
        {
          "id": "goodsIssue",
          "title": "Post goods issue",
          "agent": "sd",
          "tool": "sd_postGoodsIssue",
          "arguments": { "salesOrder": "${input.salesOrder}" },
          "skipWhen": [{ "value": "${steps.order.goodsIssued}", "equals": "true" }]
        },
        {
          "id": "billing",
          "title": "Create the billing document",
          "agent": "sd",
          "tool": "sd_createBillingDocument",
          "arguments": { "salesOrder": "${input.salesOrder}" },
          "skipWhen": [{ "value": "${steps.order.billed}", "equals": "true" }]
        },
        {
          "id": "verify",
          "title": "Verify the document flow",
          "agent": "sd",
          "tool": "sd_getSalesOrderFlow",
          "arguments": { "salesOrder": "${input.salesOrder}" }
        },
        {
          "id": "receivable",
          "title": "Check the customer account",
          "agent": "fico",
          "tool": "ar_listCustomerOpenItems",
          "arguments": { "customer": "${steps.order.soldTo}", "companyCode": "${input.companyCode}", "status": "OPEN" }
        }
      ]
    },
    {
      "id": "purchase-to-pay",
      "name": "Purchase-to-pay",
      "description": "Takes a purchase order through goods receipt and supplier invoice with three-way match, then verifies the document flow and the supplier account.",
      "agents": ["mm"],
      "subject": "purchase order ${input.purchaseOrder}",
      "input": [
        { "name": "purchaseOrder", "label": "Purchase order", "pattern": "^\\d{10}$" },
        { "name": "companyCode", "label": "Company code", "pattern": "^[A-Z0-9]{4}$" },
        { "name": "invoiceReference", "label": "Supplier invoice number", "pattern": "^[A-Za-z0-9./-]{1,16}$" },
        { "name": "invoiceAmount", "label": "Invoice gross amount", "pattern": "^\\d{1,12}(\\.\\d{1,2})?$" }
      ],
      "steps": [
        {
          "id": "order",
          "title": "Check the purchase order",
          "agent": "mm",
          "tool": "mm_getPurchaseOrderFlow",
          "arguments": { "purchaseOrderNumber": "${input.purchaseOrder}" }
        },
        {
          "id": "receipt",
          "title": "Post the goods receipt",
          "agent": "mm",
          "tool": "mm_postGoodsReceipt",
          "arguments": { "purchaseOrder": "${input.purchaseOrder}" },
          "skipWhen": [{ "value": "${steps.order.received}", "equals": "true" }]
        },
        {
          "id": "invoice",
          "title": "Enter the supplier invoice",
          "agent": "mm",
          "tool": "mm_createSupplierInvoice",
          "arguments": { "purchaseOrder": "${input.purchaseOrder}", "reference": "${input.invoiceReference}", "grossAmount": "${input.invoiceAmount}" },
          "skipWhen": [{ "value": "${steps.order.invoiced}", "equals": "true" }]
        },
        {
          "id": "verify",
          "title": "Verify the document flow",
          "agent": "mm",
          "tool": "mm_getPurchaseOrderFlow",
          "arguments": { "purchaseOrderNumber": "${input.purchaseOrder}" },
          "haltWhen": [
            {
              "value": "${steps.verify.paymentBlocked}",
              "equals": "true",
              "reason": "The supplier invoice is blocked for payment by invoice verification. The variance must be resolved before it can be paid."
            }
          ]
        },
        {
          "id": "payable",
          "title": "Check the supplier account",
          "agent": "fico",
          "tool": "ap_listVendorOpenItems",
          "arguments": { "supplier": "${steps.order.supplier}", "companyCode": "${input.companyCode}", "status": "OPEN" }
        }
      ]
    }
  ]
}
