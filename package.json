{
  "name": "prowess-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Prowess AI — Enterprise Intelligence Workspace for SAP on BTP Cloud Foundry",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sap": "vitest run --config tests/sap-integration/vitest.config.ts",
    "build:cf": "npm run build -w @prowess/orchestrator && npm run build -w @prowess/sap-mcp && npm run build -w @prowess/web && node scripts/package-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
