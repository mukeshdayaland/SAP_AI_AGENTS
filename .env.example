# ---------------------------------------------------------------------------
# Prowess AI — local configuration template.
# Copy to `.env` for local development. NEVER commit real values.
# On SAP BTP, provide secrets via service bindings (aicore, xsuaa, …) or the
# user-provided service `prowess-secrets` — see docs/btp-deployment.md.
# ---------------------------------------------------------------------------

# DEV | QA | PROD. AUTH_MODE=dev and mocks are refused outside DEV.
PROWESS_ENV=DEV
LOG_LEVEL=info

# Shared by orchestrator and SAP MCP to sign principal/confirmation assertions.
# ≥ 32 random chars. scripts/dev.mjs generates an ephemeral one if unset.
SERVICE_ASSERTION_SECRET=

# ------------------------------- Model routing -----------------------------
# Preferred provider moved to the front of every tier in config/models.json:
# sap-ai-core | azure-ai-foundry | aws-bedrock | gcp-vertex | mock
DEFAULT_LLM_PROVIDER=
# Offline mock model (DEV only; forbidden in PROD).
LLM_ALLOW_MOCK=true
# Comma-separated providers to ignore even if configured.
LLM_DISABLED_PROVIDERS=

# ------------------------------- SAP AI Core -------------------------------
# Either paste the service key JSON …
AICORE_SERVICE_KEY=
# … or the individual fields (on BTP the `aicore` binding is read automatically).
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_API_URL=
AICORE_RESOURCE_GROUP=default
# orchestration (all generative AI hub models) | foundation (OpenAI-family deployment IDs)
AICORE_MODE=orchestration
AICORE_ORCHESTRATION_DEPLOYMENT_ID=
# SAP Data Privacy Integration anonymization of names/emails/phones.
AICORE_MASKING=false

# ----------------------------- Azure AI Foundry ----------------------------
AZURE_AI_ENDPOINT=
# openai-v1 | openai-deployments | model-inference
AZURE_AI_API_STYLE=openai-v1
AZURE_AI_API_VERSION=
# workload-identity (recommended) | client-secret | api-key (dev only)
AZURE_AI_AUTH=api-key
AZURE_AI_API_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=

# -------------------------------- AWS Bedrock ------------------------------
AWS_BEDROCK_REGION=
# sigv4 (prefer temporary STS credentials) | api-key (dev only)
AWS_BEDROCK_AUTH=sigv4
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_GUARDRAIL_ID=
AWS_BEDROCK_GUARDRAIL_VERSION=

# ----------------------------- Google Vertex AI ----------------------------
GCP_PROJECT_ID=
GCP_LOCATION=europe-west3
# workload-identity (recommended) | service-account | access-token (dev only)
GCP_AUTH=
GCP_WIF_AUDIENCE=
GCP_WIF_SUBJECT_TOKEN_FILE=
GCP_WIF_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_ACCESS_TOKEN=

# ----------------------------------- SAP -----------------------------------
# mock (DEV only) | odata (BTP Destination + Connectivity)
SAP_MODE=mock
SAP_DESTINATION=S4HANA
SAP_SYSTEM_ID=
# Allow SAP calls without an end-user token (technical user). See docs/sap-connectivity.md.
SAP_ALLOW_TECHNICAL_USER=false
# Split MCP domains across services later, e.g. fico,mm,pm,shared
MCP_DOMAINS=fico,mm,pm,shared

# ------------------------------ Orchestrator -------------------------------
AUTH_MODE=dev
SAP_MCP_URL=http://localhost:4100/mcp
# Or several servers: [{"id":"fico","url":"https://…/mcp"},{"id":"pm","url":"…"}]
MCP_SERVERS=
PERSISTENCE=memory
DATABASE_URL=
CONVERSATION_RETENTION_DAYS=90
RATE_LIMIT_PER_MINUTE=30
DAILY_TOKENS_PER_USER=400000
DAILY_TOKENS_PER_AGENT=20000000
MAX_CONCURRENT_STREAMS_PER_USER=2
LLM_MAX_TOOL_ROUNDS=5
CONFIRMATION_TTL_SECONDS=600
# Raise (never lower) a tool's risk: {"fico_addInvoiceNote":"BUSINESS_WRITE"}
TOOL_RISK_OVERRIDES=

UPLOADS_ENABLED=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,csv,txt,png,jpg
UPLOAD_RETENTION_HOURS=24
# none (DEV only) | clamav
MALWARE_SCANNER=none
CLAMAV_HOST=
CLAMAV_PORT=3310
